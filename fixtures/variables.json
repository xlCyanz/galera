{
  "version": 1,
  "meta": { "title": "Variables" },
  "fonts": ["fonts/Inter-Regular.ttf"],
  "variables": {
    "empresa": { "kind": "text", "value": "Cooperativa #1 del Este" },
    "fecha": { "kind": "date", "value": "2026-09-21" },
    "total": { "kind": "number", "value": "1250.5" },
    "pendiente": { "kind": "text", "value": "" }
  },
  "pages": [
    {
      "id": "p1",
      "size": { "width": 210, "height": 297, "unit": "mm" },
      "elements": [
        { "id": "titulo", "type": "text", "x": 20, "y": 30, "w": 170, "h": null,
          "content": [ { "text": "Informe de {{empresa}}" } ],
          "style": { "font": "Inter", "size": 18, "color": "#1F2733" } },
        { "id": "cuerpo", "type": "text", "x": 20, "y": 60, "w": 170, "h": null,
          "content": [
            { "text": "A fecha de " },
            { "text": "{{fecha}}", "bold": true },
            { "text": ", el total es de {{total}} euros.\nFirmado: {{pendiente}}" }
          ],
          "style": { "font": "Inter", "size": 12, "color": "#1F2733" } },
        { "id": "suelta", "type": "text", "x": 20, "y": 100, "w": 170, "h": null,
          "content": [ { "text": "Una llave { suelta y {{sin-definir}} no valen." } ],
          "style": { "font": "Inter", "size": 12, "color": "#1F2733" } }
      ]
    }
  ]
}
